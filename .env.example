# ── Supabase edge functions (Client/supabase/functions/ai-chat, ai-complete) ────
# Set these in your Supabase project's edge function environment variables, not here.
OPENAI_API_KEY=sk-...

# Comma-separated origins allowed to call ai-chat and ai-complete. Add your
# production domain here when it changes — an unlisted origin is rejected by CORS.
ALLOWED_ORIGINS=https://sportslabai.onrender.com

# ── Frontend (Client/.env) ─────────────────────────────────────────────────────
# Create a Client/.env file with these variables (React requires REACT_APP_ prefix)
REACT_APP_SUPABASE_URL=https://your-project.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-anon-key

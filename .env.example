# ── Supabase edge functions (client/supabase/functions/ai-chat, ai-complete) ────
# Set this in your Supabase project's edge function environment variables, not here.
OPENAI_API_KEY=sk-...

# ── Frontend (client/.env) ─────────────────────────────────────────────────────
# Create a client/.env file with these variables (React requires REACT_APP_ prefix)
REACT_APP_SUPABASE_URL=https://your-project.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-anon-key

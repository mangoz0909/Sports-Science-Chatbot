# Placeholder Supabase config so `npm test` runs without a real .env.
# src/lib/supabaseClient.ts throws at import time when these are missing, which
# would fail any test that transitively imports a service. No network call is
# made in tests — these values are never used against a real project.
REACT_APP_SUPABASE_URL=https://test.supabase.co
REACT_APP_SUPABASE_ANON_KEY=test-anon-key
